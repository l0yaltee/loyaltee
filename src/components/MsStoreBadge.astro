---
// The official-looking "Get it from Microsoft" badge used on both sites.
import { links } from '../config';
interface Props { compact?: boolean; class?: string }
const { compact = false, class: className } = Astro.props;
---
<a class:list={['ms-badge', { 'ms-badge--compact': compact }, className]} href={links.store} aria-label="Get it from Microsoft">
  <svg width={compact ? 22 : 24} height={compact ? 22 : 24} viewBox="0 0 23 23" aria-hidden="true"><path fill="#f25022" d="M1 1h10v10H1z"></path><path fill="#7fba00" d="M12 1h10v10H12z"></path><path fill="#00a4ef" d="M1 12h10v10H1z"></path><path fill="#ffb900" d="M12 12h10v10H12z"></path></svg>
  <span class="ms-badge__text"><small>Get it from</small><b>Microsoft</b></span>
</a>

<style>
  .ms-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    box-sizing: border-box;
    background: #000;
    color: #fff;
    border: 1px solid #5f5f5f;
    border-radius: 8px;
    padding: 10px 20px 10px 15px;
    font-family: 'Segoe UI', 'Inter Variable', Inter, sans-serif;
    transition: border-color 0.2s ease;
  }
  .ms-badge:hover { color: #fff; border-color: #a1a1a1; }
  .ms-badge__text { display: flex; flex-direction: column; }
  .ms-badge small { font-size: 11px; line-height: 13px; }
  .ms-badge b { font-size: 18px; line-height: 22px; font-weight: 600; }
  .ms-badge--compact { gap: 10px; min-height: 46px; padding: 8px 16px 8px 12px; }
  .ms-badge--compact small { font-size: 10px; line-height: 12px; }
  .ms-badge--compact b { font-size: 16px; line-height: 20px; }
</style>
