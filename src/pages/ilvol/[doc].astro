---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource/press-start-2p/400';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400';
import '@fontsource/jetbrains-mono/500';
import '../../styles/ilvol.css';
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IlvolHeader from '../../components/IlvolHeader.astro';
import IlvolFooter from '../../components/IlvolFooter.astro';
import { links, ilvolIcons } from '../../config';

// /ilvol/privacy and /ilvol/terms, from src/content/legal/.
export const getStaticPaths = (async () => {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc } }));
}) satisfies GetStaticPaths;

const { doc } = Astro.props;
const { Content } = await render(doc);
const { title, description } = doc.data;
---

<Base title={`${title} — IlvolAI`} description={description} themeColor="#0e1216" {...ilvolIcons} introKey="ilvol-intro" noIntro>
  <div class="page">
    <IlvolHeader current="legal" />
    <main class="wrap guide">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={links.ilvol}>IlvolAI</a><span aria-hidden="true">/</span><span>{title}</span></nav>
      <header class="guide__head">
        <h1 class="display guide__title">{title}</h1>
      </header>
      <article class="prose prose--legal">
        <Content />
      </article>
    </main>
    <IlvolFooter />
  </div>
</Base>
